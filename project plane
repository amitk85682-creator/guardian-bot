javascript// server.js — Full implementation:

require('dotenv').config();
const express = require('express');
const http = require('http');
const WebSocket = require('ws');
const path = require('path');
const { askGemini, resetConversation } = require('./gemini');
const { createHeyGenSession, sendAvatarText, closeHeyGenSession } = require('./heygen');
const { executeTool } = require('./tools');

const app = express();
app.use(cors());  // import cors at top
app.use(express.json());
app.use(express.static(path.join(__dirname, 'public')));

const server = http.createServer(app);
const wss = new WebSocket.Server({ server });

// Store active HeyGen sessions per client
const sessions = new Map();

wss.on('connection', (ws) => {
  console.log('Client connected');
  const clientId = Date.now().toString();

  ws.on('message', async (raw) => {
    let msg;
    try { msg = JSON.parse(raw); } catch { return; }

    if (msg.type === 'chat') {
      try {
        // 1. Get AI response from Gemini
        const aiResponse = await askGemini(msg.text, clientId);
        
        // 2. Send text response to frontend immediately
        ws.send(JSON.stringify({ type: 'ai_text', text: aiResponse }));

        // 3. If avatar session is active, make avatar speak
        const session = sessions.get(clientId);
        if (session) {
          await sendAvatarText(session, aiResponse);
        }

        // 4. Check if Gemini flagged a tool/task to execute
        if (aiResponse.includes('[TOOL:')) {
          const toolMatch = aiResponse.match(/\[TOOL:(\w+):([^\]]+)\]/);
          if (toolMatch) {
            const result = await executeTool(toolMatch[1], toolMatch[2]);
            ws.send(JSON.stringify({ type: 'tool_result', result }));
          }
        }
      } catch (err) {
        ws.send(JSON.stringify({ type: 'error', message: err.message }));
      }
    }

    if (msg.type === 'start_avatar') {
      try {
        const session = await createHeyGenSession();
        sessions.set(clientId, session);
        ws.send(JSON.stringify({ 
          type: 'avatar_ready', 
          sessionId: session.session_id,
          sdp: session.sdp,
          iceServers: session.ice_servers
        }));
      } catch (err) {
        ws.send(JSON.stringify({ type: 'error', message: 'Avatar failed: ' + err.message }));
      }
    }

    if (msg.type === 'stop_avatar') {
      const session = sessions.get(clientId);
      if (session) {
        await closeHeyGenSession(session);
        sessions.delete(clientId);
        ws.send(JSON.stringify({ type: 'avatar_stopped' }));
      }
    }

    if (msg.type === 'reset') {
      resetConversation(clientId);
      ws.send(JSON.stringify({ type: 'reset_done' }));
    }
  });

  ws.on('close', async () => {
    const session = sessions.get(clientId);
    if (session) await closeHeyGenSession(session).catch(() => {});
    sessions.delete(clientId);
    console.log('Client disconnected');
  });
});

const PORT = process.env.PORT || 3000;
server.listen(PORT, () => {
  console.log(`✅ NIYATI is running at http://localhost:${PORT}`);
});
