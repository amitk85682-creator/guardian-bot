🛠️ STEP 5 — BUILD tools.js (System Task Executor)
This file handles real laptop tasks when Gemini embeds a [TOOL:...] command.
javascript// tools.js — Full implementation:

const { exec } = require('child_process');
const fs = require('fs');
const open = require('open');

async function executeTool(toolName, args) {
  console.log(`[TOOL] Executing: ${toolName} with args: ${args}`);

  switch (toolName) {

    case 'open_url': {
      await open(args);
      return `Opened ${args} in your default browser.`;
    }

    case 'search': {
      const searchUrl = `https://www.google.com/search?q=${encodeURIComponent(args)}`;
      await open(searchUrl);
      return `Searching for "${args}" on Google.`;
    }

    case 'open_app': {
      const appName = args.toLowerCase().trim();
      // Cross-platform app opening
      const platform = process.platform;
      if (platform === 'win32') {
        exec(`start ${appName}`);
      } else if (platform === 'darwin') {
        exec(`open -a "${appName}"`);
      } else {
        exec(`${appName} &`);
      }
      return `Opening ${args}...`;
    }

    case 'create_file': {
      const [filename, ...contentParts] = args.split('|');
      const content = contentParts.join('|');
      const filePath = require('path').join(require('os').homedir(), 'Desktop', filename.trim());
      fs.writeFileSync(filePath, content || '', 'utf8');
      return `File "${filename.trim()}" created on your Desktop.`;
    }

    case 'get_time': {
      const now = new Date();
      return `Current time: ${now.toLocaleString()}`;
    }

    default:
      return `Unknown tool: ${toolName}`;
  }
}

module.exports = { executeTool };

