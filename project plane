🎭 STEP 4 — BUILD heygen.js (Live Avatar)
This file manages the HeyGen Streaming Avatar API. It must:

Create a streaming session using HeyGen's API
Return the WebRTC SDP and ICE server details to the frontend
Send text to the avatar to speak in real-time
Close the session cleanly

Use HeyGen's v2 Streaming API endpoints:

Create session: POST https://api.heygen.com/v1/streaming.new
Start session: POST https://api.heygen.com/v1/streaming.start
Send task (speak text): POST https://api.heygen.com/v1/streaming.task
Stop session: POST https://api.heygen.com/v1/streaming.stop

javascript// heygen.js — Full implementation:

const axios = require('axios');

const HEYGEN_BASE = 'https://api.heygen.com';
const HEADERS = {
  'x-api-key': process.env.HEYGEN_API_KEY,
  'Content-Type': 'application/json'
};

async function createHeyGenSession() {
  // Step 1: Create a new streaming session
  const createRes = await axios.post(`${HEYGEN_BASE}/v1/streaming.new`, {
    quality: 'high',
    avatar_name: process.env.HEYGEN_AVATAR_ID,
    voice: {
      voice_id: process.env.HEYGEN_VOICE_ID
    },
    video_encoding: 'H264',
    knowledge_base: '',
    disable_idle_timeout: false
  }, { headers: HEADERS });

  if (createRes.data.code !== 100) {
    throw new Error('HeyGen session creation failed: ' + JSON.stringify(createRes.data));
  }

  const sessionData = createRes.data.data;
  
  return {
    session_id: sessionData.session_id,
    sdp: sessionData.sdp,           // SDP offer from HeyGen
    ice_servers: sessionData.ice_servers,
    access_token: sessionData.access_token
  };
}

async function startHeyGenSession(session, clientSdpAnswer) {
  // Step 2: Start session with client's SDP answer
  const startRes = await axios.post(`${HEYGEN_BASE}/v1/streaming.start`, {
    session_id: session.session_id,
    sdp: clientSdpAnswer
  }, { headers: HEADERS });

  if (startRes.data.code !== 100) {
    throw new Error('HeyGen session start failed: ' + JSON.stringify(startRes.data));
  }
  return startRes.data;
}

async function sendAvatarText(session, text) {
  // Clean the text — remove [TOOL:...] tags before speaking
  const cleanText = text.replace(/\[TOOL:[^\]]+\]/g, '').trim();
  if (!cleanText) return;

  const taskRes = await axios.post(`${HEYGEN_BASE}/v1/streaming.task`, {
    session_id: session.session_id,
    text: cleanText,
    task_type: 'talk'
  }, { headers: HEADERS });

  if (taskRes.data.code !== 100) {
    console.error('HeyGen task failed:', taskRes.data);
  }
  return taskRes.data;
}

async function closeHeyGenSession(session) {
  await axios.post(`${HEYGEN_BASE}/v1/streaming.stop`, {
    session_id: session.session_id
  }, { headers: HEADERS }).catch(console.error);
}

module.exports = { createHeyGenSession, startHeyGenSession, sendAvatarText, closeHeyGenSession };
