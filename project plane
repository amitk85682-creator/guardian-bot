🤖 STEP 3 — BUILD gemini.js (AI Brain)
This file handles all communication with Google Gemini 1.5 Pro. It must:

Maintain conversation history per client (multi-turn memory)
Use a detailed system prompt that defines NIYATI's personality
Detect when the user wants to perform a system task and embed a [TOOL:name:args] tag in the response
Export: askGemini(userText, clientId) and resetConversation(clientId)

javascript// gemini.js — Full implementation:

const { GoogleGenerativeAI } = require('@google/generative-ai');

const genAI = new GoogleGenerativeAI(process.env.GEMINI_API_KEY);

const SYSTEM_PROMPT = `
You are NIYATI, an advanced AI assistant — intelligent, calm, and precise like JARVIS from Iron Man.
You assist the user with tasks on their laptop and answer any question with deep knowledge.

YOUR PERSONALITY:
- Speak in a warm but professional tone
- Be concise — avoid rambling. Give clear, direct answers
- Address the user as "Sir" or "Ma'am" occasionally (be subtle, not robotic)
- Show subtle wit and intelligence
- If user speaks in Hindi or Hinglish, respond in the same language naturally

YOUR CAPABILITIES — when the user asks you to perform these tasks, include a [TOOL:...] tag:
- Open a website: respond with [TOOL:open_url:https://example.com]
- Search the web: respond with [TOOL:search:query text here]
- Open an application: respond with [TOOL:open_app:appname]
- Create a file: respond with [TOOL:create_file:filename|content]
- Get current time/date: respond with [TOOL:get_time:now]

IMPORTANT RULES:
1. Always give a natural conversational response FIRST, then add the [TOOL:...] tag at the very end if needed
2. Never expose raw technical details unless asked
3. If you don't know something, say so honestly
4. Keep responses under 3 sentences for simple questions; be detailed only when needed
5. You have access to conversation history — remember what was said earlier
`;

// Store conversation history: clientId → array of {role, parts}
const histories = new Map();

async function askGemini(userText, clientId) {
  if (!histories.has(clientId)) {
    histories.set(clientId, []);
  }
  const history = histories.get(clientId);

  const model = genAI.getGenerativeModel({ 
    model: 'gemini-1.5-pro',
    systemInstruction: SYSTEM_PROMPT
  });

  const chat = model.startChat({ history });

  const result = await chat.sendMessage(userText);
  const responseText = result.response.text();

  // Update history
  history.push({ role: 'user', parts: [{ text: userText }] });
  history.push({ role: 'model', parts: [{ text: responseText }] });

  // Keep last 20 turns to avoid token overflow
  if (history.length > 40) history.splice(0, 2);

  return responseText;
}

function resetConversation(clientId) {
  histories.delete(clientId);
}

module.exports = { askGemini, resetConversation };
